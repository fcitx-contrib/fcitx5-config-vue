    "naive-ui": "^2.45.3",
    "serve": "^14.2.6",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vooks": "^0.2.12",
    "vue": "^3.5.44",
    "vue-i18n": "11",
    "vue-tsc": "^3.3.13"
  }
